<Window x:Class="MasterFloorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterFloorWPF"
        mc:Ignorable="d"
        Title="Мастер пол" Height="450" Width="800">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Image Source="Мастер пол.png" Height="50" Width="50" Margin="10" HorizontalAlignment="Left"/>
        <Label Content="Список партнеров" Margin="80,13,0,0" FontSize="24" HorizontalAlignment="Left"/>
        <Button Content="Добавить партнера" Height="30" HorizontalAlignment="Right" Background="#67BA80" Width="160" Margin="5,0,25,0" Click="Add_Click" />

        <ListView Name="PartnersListView" ItemsSource="{Binding Partners}" SelectedItem="{Binding SelectedPartner, Mode=TwoWay}" SelectionChanged="ListView_SelectionChanged" HorizontalContentAlignment="Stretch" Grid.Row="1">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Margin="10" Padding="10" Background="#F4E8D3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18">
                                        <Run Text="{Binding TypePartner}" /> 
                                        <Run Text=" | "/>
                                        <Run Text="{Binding NameOrganization}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Director}" />
                                <TextBlock Text="{Binding PhoneNumber}" />
                                <TextBlock Text="Рейтинг: ">
                                        <Run Text="{Binding Rating}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" FontSize="18" VerticalAlignment="Top" Text="{Binding DiscountText}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ListView>

    </Grid>
</Window>
