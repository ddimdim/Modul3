<Window x:Class="MasterFloorWPF.Views.NewPartnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterFloorWPF.Views"
        mc:Ignorable="d"
        Title="Мастер пол" Height="570" Width="500">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Source="C:\Users\shurk\Desktop\wpf_practica\MasterFloorWPF\MasterFloorWPF\Мастер пол.png" Height="50" Width="50" Margin="10" HorizontalAlignment="Left"/>
        <Label x:Name="Title" Content="Добавление партнера" Margin="80,15,0,0" FontSize="24" HorizontalAlignment="Left"/>
        <StackPanel Grid.Row="1" Margin="10">

            <Label Content="Наименование"/>
            <TextBox x:Name="Name" Margin="0,5"/>

            <Label Content="Тип партнера"/>
            <ComboBox x:Name="TypeComboBox" Margin="0,5"/>

            <Label Content="Рейтинг"/>
            <TextBox x:Name="Rating" Margin="0,5"/>

            <Label Content="Адрес"/>
            <TextBox x:Name="Address" Margin="0,5"/>

            <Label Content="ФИО директора"/>
            <TextBox x:Name="Director" Margin="0,5"/>

            <Label Content="Телефон"/>
            <TextBox x:Name="Phone" Margin="0,5"/>

            <Label Content="Email"/>
            <TextBox x:Name="Email" Margin="0,5"/>
        </StackPanel>
        <StackPanel Margin="10" Grid.Row="2" Orientation="Horizontal">
            <Button Content="Назад" Width="80" Height="30" Margin="5" Click="Cancel_Click"/>
            <Button Content="Сохранить" Height="30" Background="#67BA80" Width="80" Margin="5" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
